  "userManual": {
    "docTitle": "AviSafe",
    "subtitle": "User Manual",
    "subtitle2": "Drone Operations and Flight Safety",
    "version": "Version 1.0 - {{date}}",
    "toc": "Table of contents",
    "footer": "AviSafe User Manual - Page {{page}} of {{total}}",
    "sections": {
      "s1": {
        "title": "1. Introduction to AviSafe",
        "content": [
          {
            "type": "paragraph",
            "text": "AviSafe is a complete management system for drone operators covering the entire operational cycle - from planning and executing missions to incident reporting and document management. The system is built to meet the requirements of the drone regulations and supports ECCAIRS reporting to the Civil Aviation Authority."
          }
        ]
      },
      "s2": {
        "title": "2. Login and User Registration",
        "content": [
          {
            "type": "heading",
            "text": "First-time registration"
          },
          {
            "type": "numbered-list",
            "items": [
              "Go to the login page",
              "Click \"Create account\"",
              "Fill in: Email address, Password, Full name, Registration code (6-character code from your company/administrator)",
              "Click \"Register\"",
              "Important: The account must be approved by an administrator before you get access"
            ]
          },
          {
            "type": "heading",
            "text": "Login"
          },
          {
            "type": "list",
            "items": [
              "Use email and password",
              "If you have forgotten your password, click \"Forgot password\" to receive a reset link"
            ]
          }
        ]
      },
      "s3": {
        "title": "3. The Dashboard (Home Page)",
        "content": [
          {
            "type": "paragraph",
            "text": "When you log in you arrive at the dashboard - your central overview of the entire operation."
          },
          {
            "type": "heading",
            "text": "Widgets on the dashboard"
          },
          {
            "type": "table",
            "headers": [
              "Widget",
              "Description"
            ],
            "rows": [
              [
                "News",
                "Latest news and updates from the organization"
              ],
              [
                "Status",
                "Overview of resource status (drones, equipment, documents) with traffic lights"
              ],
              [
                "Documents",
                "Important documents with expiry warnings"
              ],
              [
                "Calendar",
                "Upcoming missions, maintenance and events"
              ],
              [
                "Missions",
                "List of upcoming and ongoing missions"
              ],
              [
                "Incidents",
                "Latest reported incidents"
              ],
              [
                "KPI chart",
                "Visualization of key figures"
              ]
            ]
          },
          {
            "type": "heading",
            "text": "Flight logging from the dashboard"
          },
          {
            "type": "list",
            "items": [
              "\"Log flight time\" - Register flight time manually",
              "\"Start flight\" - Start an active flight with timer and optional SafeSky sharing",
              "\"Stop flight\" - End an ongoing flight and log details"
            ]
          },
          {
            "type": "heading",
            "text": "Customization"
          },
          {
            "type": "paragraph",
            "text": "You can drag and drop widgets to change the order. The layout is saved automatically."
          }
        ]
      },
      "s4": {
        "title": "4. Missions",
        "content": [
          {
            "type": "heading",
            "text": "View all missions"
          },
          {
            "type": "paragraph",
            "text": "Click \"Missions\" in the menu to see ongoing, upcoming and completed missions."
          },
          {
            "type": "heading",
            "text": "Create a new mission"
          },
          {
            "type": "numbered-list",
            "items": [
              "Click \"+ Add mission\"",
              "Fill in: Title (required), Location (search for address), Time (start and optional end), Description, Customer, Personnel, Drones, Equipment, Documents, Status",
              "Click \"Save\""
            ]
          },
          {
            "type": "heading",
            "text": "Route planning"
          },
          {
            "type": "numbered-list",
            "items": [
              "Click \"Plan route\" in the mission dialog",
              "You are taken to the map view",
              "Click on the map to set route points",
              "See total distance and VLOS status",
              "Click \"Save route\" to attach it to the mission"
            ]
          },
          {
            "type": "heading",
            "text": "Risk assessment"
          },
          {
            "type": "list",
            "items": [
              "AI-based risk assessment - Automatic analysis based on weather data, airspace, etc.",
              "Manual SORA analysis - Structured risk assessment using the SORA methodology"
            ]
          },
          {
            "type": "heading",
            "text": "Export"
          },
          {
            "type": "list",
            "items": [
              "PDF export - Complete mission report incl. map and SORA",
              "KMZ export - Route file for Google Earth"
            ]
          }
        ]
      },
      "s5": {
        "title": "5. The Map",
        "content": [
          {
            "type": "paragraph",
            "text": "Interactive map with flight-relevant information."
          },
          {
            "type": "heading",
            "text": "Map layers (can be toggled on/off)"
          },
          {
            "type": "table",
            "headers": [
              "Layer",
              "Content"
            ],
            "rows": [
              [
                "Airspace zones",
                "CTR, TIZ, restricted areas from OpenAIP"
              ],
              [
                "5km zones",
                "Zones around airports (RPAS regulations)"
              ],
              [
                "NSM restrictions",
                "National security zones"
              ],
              [
                "Active aircraft",
                "Live position from ADS-B"
              ],
              [
                "Weather stations",
                "Local weather data"
              ]
            ]
          },
          {
            "type": "heading",
            "text": "Route planning on the map"
          },
          {
            "type": "numbered-list",
            "items": [
              "Click \"Plan route\" (or arrive from the mission dialog)",
              "Click on the map to add route points",
              "See automatically: Total route length, Maximum distance from pilot (VLOS), Airspace conflict warnings",
              "Click \"Save route\" to finish"
            ]
          }
        ]
      },
      "s6": {
        "title": "6. Documents",
        "content": [
          {
            "type": "paragraph",
            "text": "Centralized document management with expiry warnings."
          },
          {
            "type": "heading",
            "text": "Categories"
          },
          {
            "type": "list",
            "items": [
              "Regulations",
              "Procedures",
              "Checklists",
              "Reports",
              "Websites",
              "Mission documents",
              "Logbook",
              "KML/KMZ files",
              "Document management",
              "Risk assessments",
              "Other"
            ]
          },
          {
            "type": "heading",
            "text": "Create a document"
          },
          {
            "type": "numbered-list",
            "items": [
              "Click \"+ New document\"",
              "Fill in: Title, Category, Description, Valid until (expiry date), Warning days before expiry",
              "Upload a file OR specify a website URL"
            ]
          },
          {
            "type": "heading",
            "text": "Create a checklist"
          },
          {
            "type": "numbered-list",
            "items": [
              "Click \"New checklist\"",
              "Add checklist items",
              "Checklists can be linked to: Drones (for inspection), Equipment (for maintenance), Flight (for takeoff)"
            ]
          },
          {
            "type": "heading",
            "text": "Expiry warnings"
          },
          {
            "type": "table",
            "headers": [
              "Color",
              "Status"
            ],
            "rows": [
              [
                "Red",
                "Expired"
              ],
              [
                "Yellow",
                "Expiring soon"
              ],
              [
                "Green",
                "OK"
              ]
            ]
          }
        ]
      },
      "s7": {
        "title": "7. Incidents (Occurrence Reporting)",
        "content": [
          {
            "type": "paragraph",
            "text": "Complete system for incident reporting and ECCAIRS integration."
          },
          {
            "type": "heading",
            "text": "Report an incident"
          },
          {
            "type": "numbered-list",
            "items": [
              "Click \"+ Add incident\"",
              "Fill in: Title, Time of occurrence, Severity (Low, Medium, High, Critical)",
              "Select: Category, Location, Description, Root cause, Contributing cause",
              "Link to a mission (optional) and select a follow-up owner"
            ]
          },
          {
            "type": "heading",
            "text": "Incident handling - Status"
          },
          {
            "type": "numbered-list",
            "items": [
              "Open - Recently reported",
              "Under investigation - Being investigated",
              "Resolved - Action identified",
              "Closed - Finished"
            ]
          },
          {
            "type": "heading",
            "text": "ECCAIRS reporting"
          },
          {
            "type": "numbered-list",
            "items": [
              "Click \"Classify\" to map to the ECCAIRS taxonomy",
              "Select: Occurrence type (VL390), Occurrence class, Flight phase, Aircraft category, Narrative",
              "Click \"Create draft in ECCAIRS\" to create it in the E2 system",
              "When ready: \"Send to Civil Aviation Authority\""
            ]
          },
          {
            "type": "paragraph",
